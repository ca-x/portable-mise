<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:PortableMise.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls">
  <Style TargetType="{x:Type controls:SvgIcon}"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:SvgIcon}"><Viewbox Stretch="Uniform"><Grid Width="24" Height="24"><Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Grid></Viewbox></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type controls:PathPicker}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:PathPicker}">
    <Grid Height="40"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"/><VisualState x:Name="Focused"><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#007AFF" Duration="0:0:0.1"/></Storyboard></VisualState></VisualStateGroup><VisualStateGroup x:Name="ValidationStates"><VisualState x:Name="Valid"/><VisualState x:Name="Invalid"><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#C53E3E" Duration="0:0:0.1"/></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
      <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
      <TextBlock Text="{TemplateBinding Caption}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <Border x:Name="Frame" Grid.Column="1" Height="40" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="8"><Border.BorderBrush><SolidColorBrush Color="#E5E5EA"/></Border.BorderBrush><TextBox x:Name="PART_PathTextBox" Height="38" MinHeight="0" BorderThickness="0" Background="Transparent" Padding="12,8" VerticalContentAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="12" AutomationProperties.Name="{TemplateBinding Caption}"/></Border>
      <Button x:Name="PART_BrowseButton" Grid.Column="3" Content="{loc:Tr '浏览'}" Height="40" Padding="12,8" AutomationProperties.Name="{loc:Tr '选择目录'}"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type controls:StatusCard}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:StatusCard}"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="20,16">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="StatusStates"><VisualState x:Name="Missing"/><VisualState x:Name="Ready"><Storyboard><ColorAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#007AFF" Duration="0:0:0.1"/></Storyboard></VisualState><VisualState x:Name="Working"><Storyboard><ColorAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#8E8E93" Duration="0:0:0.1"/></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{TemplateBinding Caption}" Foreground="{DynamicResource Muted}" FontSize="12"/><Ellipse x:Name="StateDot" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="#C7C7CC"/></Ellipse.Fill></Ellipse><TextBlock Grid.Row="1" Text="{TemplateBinding Value}" ToolTip="{TemplateBinding Value}" Foreground="{DynamicResource Ink}" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/></Grid>
  </Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>