<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:PortableMise.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls">
  <Style TargetType="{x:Type controls:SvgIcon}"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:SvgIcon}"><Viewbox Stretch="Uniform"><Grid Width="24" Height="24"><Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Grid></Viewbox></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type controls:PathPicker}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:PathPicker}">
    <Grid Height="40"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#EFF2F7" Duration="0:0:0.18"/></Storyboard></VisualState><VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.14"/></Storyboard></VisualState></VisualStateGroup><VisualStateGroup x:Name="ValidationStates"><VisualState x:Name="Valid"/><VisualState x:Name="Invalid"><Storyboard><DoubleAnimation Storyboard.TargetName="ErrorRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
      <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
      <TextBlock Text="{TemplateBinding Caption}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <Grid Grid.Column="1">
        <Border x:Name="ErrorRing" BorderBrush="#B92F39" BorderThickness="1.5" CornerRadius="9.5" Opacity="0" IsHitTestVisible="False" Margin="-1.5"/>
        <Border x:Name="FocusRing" BorderBrush="#2458C1" BorderThickness="1.5" CornerRadius="9.5" Opacity="0" IsHitTestVisible="False" Margin="-1.5"/>
        <Border x:Name="Frame" Height="40" BorderThickness="0" CornerRadius="8"><Border.Background><SolidColorBrush Color="#EFF2F7"/></Border.Background><Grid><TextBox x:Name="PART_PathTextBox" Height="38" MinHeight="0" BorderThickness="0" Background="Transparent" Padding="12,8" VerticalContentAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="12" AutomationProperties.Name="{TemplateBinding Caption}"/></Grid></Border>
      </Grid>
      <Button x:Name="PART_BrowseButton" Grid.Column="3" Content="{loc:Tr '浏览'}" Height="40" Padding="12,8" AutomationProperties.Name="{loc:Tr '选择目录'}"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type controls:StatusCard}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:StatusCard}"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="18,16" Effect="{DynamicResource CardShadow}">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="StatusStates"><VisualState x:Name="Missing"><Storyboard><ColorAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#C3CDDA" Duration="0:0:0.16"/></Storyboard></VisualState><VisualState x:Name="Ready"><Storyboard><ColorAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#2E8B5F" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Width" From="5" To="6.5" Duration="0:0:0.18" AutoReverse="True"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Height" From="5" To="6.5" Duration="0:0:0.18" AutoReverse="True"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></VisualState><VisualState x:Name="Working"><Storyboard><ColorAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#2458C1" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <controls:SvgIcon Data="{TemplateBinding Icon}" Width="15" Height="15" Foreground="{DynamicResource MutedLight}" VerticalAlignment="Center"/>
        <TextBlock Text="{TemplateBinding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <Ellipse x:Name="StateDot" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="#C3CDDA"/></Ellipse.Fill></Ellipse>
      <TextBlock Grid.Row="1" Text="{TemplateBinding Value}" ToolTip="{TemplateBinding Value}" Foreground="{DynamicResource Ink}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
