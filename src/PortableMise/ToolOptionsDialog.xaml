<Window x:Class="PortableMise.ToolOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:PortableMise.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Tr '工具选项'}" Width="620" MinWidth="520" Height="510" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/mise.ico"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,8">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="144" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SpecificationLabel" VerticalAlignment="Center" />
              <TextBox x:Name="SpecificationBox" Grid.Column="1" FontFamily="{StaticResource MonoFont}"
                       AutomationProperties.AutomationId="ToolOptionVersionBox" />
            </Grid>
            <StackPanel x:Name="SpecificOptionRows" />
            <Expander Header="{loc:Tr '通用安装选项'}" Margin="0,4,0,0">
              <StackPanel x:Name="OtherOptionRows" Margin="0,8,0,0" />
            </Expander>
          </StackPanel>
        </Border>
        <Button x:Name="MirrorPresetsButton" Content="{loc:Tr '镜像预设'}" Click="OpenMirrorPresets"
                Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,0,0,8"
                Visibility="Collapsed" AutomationProperties.AutomationId="ToolMirrorPresetsButton" />
        <Border x:Name="WorkspaceCard" Style="{StaticResource Card}">
          <Expander x:Name="WorkspaceExpander" Header="{loc:Tr '下载源与工作区设置'}" Expanded="ExpandWorkspace">
            <StackPanel Margin="0,8,0,0">
              <TextBlock x:Name="WorkspaceHint" Style="{StaticResource Caption}" TextWrapping="Wrap" />
              <StackPanel x:Name="WorkspaceRows" Margin="0,8,0,0" />
              <Button x:Name="SaveWorkspaceButton" Content="{loc:Tr '保存到工作区'}" Click="SaveWorkspace"
                      HorizontalAlignment="Right" Margin="0,4,0,0" IsEnabled="False"
                      AutomationProperties.AutomationId="SaveToolWorkspaceButton" />
            </StackPanel>
          </Expander>
        </Border>
        <TextBlock x:Name="ToolHint" Margin="4,0,0,8" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        <TextBlock Margin="4,0,0,12" Style="{StaticResource Caption}">
          <Hyperlink x:Name="ToolDocumentation" RequestNavigate="OpenDocumentation"><Run Text="{loc:Tr '查看 mise 文档'}" /></Hyperlink>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="{loc:Tr '取消'}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="SaveTagButton" Grid.Column="2" Content="{loc:Tr '保存标签'}" Click="SaveTag"
                Style="{StaticResource PrimaryButton}" IsDefault="True"
                AutomationProperties.AutomationId="SaveToolTagButton" />
      </Grid>
    </Border>
  </Grid>
</Window>
