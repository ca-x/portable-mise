<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:PortableMise.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls">
  <DataTemplate x:Key="UpdatesPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,24">
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <controls:SvgIcon Data="{StaticResource IconRefreshCw}" Width="17" Height="17" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'mise 与开发工具'}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding UpdateAllCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="20,0,0,0" AutomationProperties.AutomationId="UpdateAllButton">
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconCircleArrowUp}" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" />
                <TextBlock Text="{loc:Tr '升级 mise 与工具'}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="18" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconTerminal}" Width="15" Height="15" VerticalAlignment="Center" />
                <TextBlock Text="mise CLI" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding MiseVersion}" TextWrapping="Wrap" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,10" />
              <Button Command="{Binding UpdateMiseCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="UpdateMiseButton">
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconDownload}" Width="13" Height="13" Margin="0,0,6,0" />
                  <TextBlock Text="{loc:Tr '更新 mise'}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconPackage}" Width="15" Height="15" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr '开发工具'}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock FontSize="23" FontWeight="SemiBold" Margin="0,10,0,10">
                <Run Text="{loc:Tr '已安装版本'}" /> <Run Text="{Binding ToolCount,Mode=OneWay}" />
              </TextBlock>
              <Button Command="{Binding UpgradeToolsCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="UpdatesUpgradeToolsButton">
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconCircleArrowUp}" Width="14" Height="14" Margin="0,0,6,0" />
                  <TextBlock Text="{loc:Tr '升级全部工具'}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconDownload}" Width="17" Height="17" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr '桌面程序'}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0">
                <Run Text="{loc:Tr '当前版本'}" /> <Run Text="{Binding ApplicationVersion,Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding AppUpdateText}" TextWrapping="Wrap" Margin="0,12,12,0" Foreground="{StaticResource Accent}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Button Command="{Binding CheckAppUpdateCommand}" Margin="0,0,0,8" AutomationProperties.AutomationId="CheckAppUpdateButton">
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconSearch}" Width="13" Height="13" Margin="0,0,6,0" />
                  <TextBlock Text="{loc:Tr '检查新版本'}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ApplyAppUpdateCommand}" IsEnabled="{Binding HasAppUpdate}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ApplyAppUpdateButton">
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconDownload}" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" />
                  <TextBlock Text="{loc:Tr '下载安装并重启'}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Margin="2,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding LastOperation}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Command="{Binding ShowTerminalCommand}" Style="{StaticResource QuietButton}">
            <StackPanel Orientation="Horizontal">
              <controls:SvgIcon Data="{StaticResource IconTerminal}" Width="13" Height="13" Margin="0,0,6,0" />
              <TextBlock Text="{loc:Tr '查看日志'}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
