<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:PortableMise.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls" xmlns:models="clr-namespace:PortableMise.Models">
  <DataTemplate x:Key="SettingsPage">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,8" IsEnabled="{Binding CanOperate}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <controls:SvgIcon Data="{StaticResource IconGlobe}" Width="17" Height="17" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr '代理'}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Tr '连接模式'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{StaticResource ProxyModes}" SelectedItem="{Binding Settings.ProxyMode,Mode=TwoWay}" AutomationProperties.AutomationId="ProxyModeBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource ProxyModeLabel}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="3" Text="{Binding Settings.ProxyAddress,UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Tr '自定义模式使用此地址，支持 HTTP / SOCKS5'}" AutomationProperties.AutomationId="ProxyAddressBox">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="IsEnabled" Value="False" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.ProxyMode}" Value="{x:Static models:ProxyMode.Custom}">
                          <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
                <Button Grid.Column="5" Command="{Binding TestProxyCommand}" AutomationProperties.AutomationId="TestProxyButton">
                  <StackPanel Orientation="Horizontal">
                    <controls:SvgIcon Data="{StaticResource IconZap}" Width="13" Height="13" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:Tr '测试'}" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:SvgIcon Data="{StaticResource IconType}" Width="15" Height="15" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr '界面语言'}" Foreground="{DynamicResource Muted}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="7,0,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Label"
                        SelectedValuePath="Id" SelectedValue="{Binding Settings.Language,Mode=TwoWay}"
                        AutomationProperties.Name="{loc:Tr '界面语言'}"
                        AutomationProperties.AutomationId="LanguageBox" />
              <TextBlock Grid.Column="3" Text="{loc:Tr '界面语言在下次启动时生效。'}"
                         Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Expander>
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconFolder}" Width="16" Height="16" VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Tr '目录'}" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,20,0,0">
                <controls:PathPicker Caption="{loc:Tr 'mise 目录'}" Text="{Binding Settings.MiseDirectory,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" BrowseCommand="{Binding BrowseMiseDirectoryCommand}" AutomationProperties.AutomationId="MiseDirectoryPicker" />
                <TextBlock Text="{Binding ResolvedMiseDirectory}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="112,8,0,16" />
                <controls:PathPicker Caption="{loc:Tr '工具目录'}" Text="{Binding Settings.ToolsDirectory,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" BrowseCommand="{Binding BrowseToolsDirectoryCommand}" AutomationProperties.AutomationId="ToolsDirectoryPicker" />
                <TextBlock Text="{Binding ResolvedToolsDirectory}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="112,8,0,16" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="RestoreButton" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <controls:SvgIcon Data="{StaticResource IconRotateCcw}" Width="13" Height="13" Margin="0,0,6,0" />
                      <TextBlock Text="{loc:Tr '恢复终端环境'}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="InstallButton">
                    <StackPanel Orientation="Horizontal">
                      <controls:SvgIcon Data="{StaticResource IconDownload}" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" />
                      <TextBlock Text="{loc:Tr '安装 mise'}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Expander>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <controls:SvgIcon Data="{StaticResource IconClock}" Width="17" Height="17" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr '自动更新'}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <CheckBox Content="{loc:Tr '开发工具'}" IsChecked="{Binding Settings.AutoUpdateTools,Mode=TwoWay}" Style="{StaticResource Switch}" AutomationProperties.AutomationId="AutoUpdateToolsToggle" />
                  <CheckBox Content="mise" IsChecked="{Binding Settings.AutoUpdateMise,Mode=TwoWay}" Style="{StaticResource Switch}" Margin="0,12,0,0" AutomationProperties.AutomationId="AutoUpdateMiseToggle" />
                  <CheckBox Content="{loc:Tr '桌面程序'}" IsChecked="{Binding Settings.AutoUpdateApplication,Mode=TwoWay}" Style="{StaticResource Switch}" Margin="0,12,0,0" AutomationProperties.AutomationId="AutoUpdateApplicationToggle" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{loc:Tr '间隔'}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Settings.UpdateIntervalHours,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="72" AutomationProperties.AutomationId="UpdateIntervalBox" />
                    <TextBlock Text="{loc:Tr '小时'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <Expander>
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconMonitor}" Width="16" Height="16" VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Tr '窗口'}" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Expander.Header>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="40" />
                  <RowDefinition Height="8" />
                  <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Tr '最小化按钮'}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Content="{loc:Tr '收起到托盘'}" IsChecked="{Binding Settings.MinimizeToTray,Mode=TwoWay}" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.AutomationId="MinimizeToTrayToggle" />
                <TextBlock Grid.Row="2" Text="{loc:Tr '关闭按钮'}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Width="210" HorizontalAlignment="Left" ItemsSource="{StaticResource CloseBehaviors}" SelectedItem="{Binding CloseBehaviorChoice,Mode=TwoWay}" AutomationProperties.AutomationId="CloseBehaviorBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource CloseBehaviorLabel}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Expander>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:SvgIcon Data="{StaticResource IconDownload}" Width="17" Height="17" VerticalAlignment="Center" />
                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr '桌面程序'}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ApplicationVersion,StringFormat=v{0}}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Command="{Binding CheckAppUpdateCommand}" Margin="8,0,8,0" AutomationProperties.AutomationId="CheckAppUpdateButton">
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconSearch}" Width="13" Height="13" Margin="0,0,6,0" />
                  <TextBlock Text="{loc:Tr '检查更新'}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Command="{Binding ApplyAppUpdateCommand}" IsEnabled="{Binding HasAppUpdate}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ApplyAppUpdateButton">
                <StackPanel Orientation="Horizontal">
                  <controls:SvgIcon Data="{StaticResource IconDownload}" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" />
                  <TextBlock Text="{loc:Tr '安装更新'}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding AppUpdateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{loc:Tr '许可证'}" Command="{Binding ShowLicenseCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="{loc:Tr 'mise 文档'}" Command="{Binding OpenDocsCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="28,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Tr '打开数据目录'}" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
          <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="SaveSettingsButton" MinWidth="112">
            <StackPanel Orientation="Horizontal">
              <controls:SvgIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr '保存设置'}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
