<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls" xmlns:models="clr-namespace:PortableMise.Models">
  <DataTemplate x:Key="SettingsPage">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,24,24,8" IsEnabled="{Binding CanOperate}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="代理" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="连接模式" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{StaticResource ProxyModes}" SelectedItem="{Binding Settings.ProxyMode,Mode=TwoWay}" AutomationProperties.AutomationId="ProxyModeBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource ProxyModeLabel}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="3" Text="{Binding Settings.ProxyAddress,UpdateSourceTrigger=PropertyChanged}" ToolTip="自定义模式使用此地址，支持 HTTP / SOCKS5" AutomationProperties.AutomationId="ProxyAddressBox">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="IsEnabled" Value="False" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.ProxyMode}" Value="{x:Static models:ProxyMode.Custom}">
                          <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
                <Button Grid.Column="5" Content="测试" Command="{Binding TestProxyCommand}" AutomationProperties.AutomationId="TestProxyButton" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <Expander Header="目录">
              <StackPanel Margin="0,20,0,0">
                <controls:PathPicker Caption="mise 目录" Text="{Binding Settings.MiseDirectory,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" BrowseCommand="{Binding BrowseMiseDirectoryCommand}" AutomationProperties.AutomationId="MiseDirectoryPicker" />
                <TextBlock Text="{Binding ResolvedMiseDirectory}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="112,8,0,16" />
                <controls:PathPicker Caption="工具目录" Text="{Binding Settings.ToolsDirectory,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" BrowseCommand="{Binding BrowseToolsDirectoryCommand}" AutomationProperties.AutomationId="ToolsDirectoryPicker" />
                <TextBlock Text="{Binding ResolvedToolsDirectory}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="112,8,0,16" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="恢复终端环境" Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="RestoreButton" Margin="0,0,8,0" />
                  <Button Content="安装 mise" Command="{Binding InstallCommand}" AutomationProperties.AutomationId="InstallButton" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="自动更新" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <CheckBox Content="开发工具" IsChecked="{Binding Settings.AutoUpdateTools,Mode=TwoWay}" Style="{StaticResource Switch}" AutomationProperties.AutomationId="AutoUpdateToolsToggle" />
                  <CheckBox Content="mise" IsChecked="{Binding Settings.AutoUpdateMise,Mode=TwoWay}" Style="{StaticResource Switch}" Margin="0,12,0,0" AutomationProperties.AutomationId="AutoUpdateMiseToggle" />
                  <CheckBox Content="桌面程序" IsChecked="{Binding Settings.AutoUpdateApplication,Mode=TwoWay}" Style="{StaticResource Switch}" Margin="0,12,0,0" AutomationProperties.AutomationId="AutoUpdateApplicationToggle" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="间隔" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Settings.UpdateIntervalHours,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="72" AutomationProperties.AutomationId="UpdateIntervalBox" />
                    <TextBlock Text="小时" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <Expander Header="窗口">
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="40" />
                  <RowDefinition Height="8" />
                  <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <TextBlock Text="最小化按钮" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Content="收起到托盘" IsChecked="{Binding Settings.MinimizeToTray,Mode=TwoWay}" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.AutomationId="MinimizeToTrayToggle" />
                <TextBlock Grid.Row="2" Text="关闭按钮" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Width="210" HorizontalAlignment="Left" ItemsSource="{StaticResource CloseBehaviors}" SelectedItem="{Binding CloseBehaviorChoice,Mode=TwoWay}" AutomationProperties.AutomationId="CloseBehaviorBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource CloseBehaviorLabel}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Expander>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="桌面程序" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ApplicationVersion,StringFormat=v{0}}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="检查更新" Command="{Binding CheckAppUpdateCommand}" Margin="8,0,8,0" AutomationProperties.AutomationId="CheckAppUpdateButton" />
              <Button Grid.Column="2" Content="安装更新" Command="{Binding ApplyAppUpdateCommand}" IsEnabled="{Binding HasAppUpdate}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ApplyAppUpdateButton" />
            </Grid>
          </Border>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding AppUpdateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="许可证" Command="{Binding ShowLicenseCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="mise 文档" Command="{Binding OpenDocsCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
          <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="SaveSettingsButton" />
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>