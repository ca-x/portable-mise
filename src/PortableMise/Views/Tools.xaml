<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:PortableMise.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls">
  <DataTemplate x:Key="ToolsPage">
    <Grid Margin="28,22,28,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
              <Button Content="{loc:Tr '语言镜像'}" Command="{Binding LanguageMirrorsCommand}"
                      Style="{StaticResource QuietButton}" Height="30" MinHeight="30" Padding="9,2" Margin="0,0,6,0"
                      AutomationProperties.AutomationId="LanguageMirrorsButton" />
              <Button Content="{loc:Tr '配置与维护'}" Command="{Binding ToolMaintenanceCommand}"
                      Style="{StaticResource QuietButton}" Height="30" MinHeight="30" Padding="9,2"
                      AutomationProperties.AutomationId="ToolMaintenanceButton" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <controls:SvgIcon Data="{StaticResource IconListPlus}" Width="17" Height="17" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr '安装队列'}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
              <TextBox Text="{Binding ToolSpecification,UpdateSourceTrigger=PropertyChanged}"
                       FontFamily="{StaticResource MonoFont}" AutomationProperties.AutomationId="ToolSpecificationBox"
                       AutomationProperties.Name="{loc:Tr '工具规格，回车加入队列'}">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding QueueToolsCommand}" /></TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="{loc:Tr '例如 node@lts，回车添加'}" Foreground="{StaticResource MutedLight}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ToolSpecification}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button Grid.Column="1" Command="{Binding QueueToolsCommand}" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="QueueToolsButton" MinWidth="76">
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconPlus}" Width="13" Height="13" Margin="0,0,6,0" />
                <TextBlock Text="{loc:Tr '添加'}" />
              </StackPanel>
            </Button>
            <ComboBox Grid.Column="2" Width="128" Margin="8,0,0,0" ItemsSource="{Binding CoreLanguageChoices}"
                      DisplayMemberPath="Label" SelectedItem="{Binding SelectedLanguage,Mode=TwoWay}"
                      AutomationProperties.AutomationId="OfficialLanguagePicker" AutomationProperties.Name="{loc:Tr '添加官方核心语言'}" />
            <Button Grid.Column="3" Command="{Binding InstallToolCommand}" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" AutomationProperties.AutomationId="InstallToolButton">
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconDownload}" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" />
                <TextBlock Text="{loc:Tr '批量安装'}" />
              </StackPanel>
            </Button>
          </Grid>
          <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding HasQueuedTools,Converter={StaticResource BoolVisibility}}">
            <ItemsControl ItemsSource="{Binding QueuedTools}" Margin="0,12,0,0" AutomationProperties.AutomationId="ToolQueue">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource QueueChip}" CornerRadius="{StaticResource ChipRadius}" Margin="0,0,8,6" Padding="10,0,4,0"
                          controls:Motion.FadeIn="True">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Label}" MaxWidth="270" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                                 VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                      <Button Style="{StaticResource QuietButton}" Width="28" Height="28" MinHeight="28" Padding="4"
                              Command="{Binding DataContext.EditQueuedToolCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{loc:Tr '工具设置'}"
                              AutomationProperties.HelpText="{Binding Label}"
                              AutomationProperties.AutomationId="QueuedToolSettingsButton" ToolTip="{loc:Tr '工具设置'}">
                        <controls:SvgIcon Data="{StaticResource IconSettings}" Width="13" Height="13" />
                      </Button>
                      <Button Style="{StaticResource QuietButton}" Width="28" Height="28" MinHeight="28" Padding="4"
                              Command="{Binding DataContext.RemoveQueuedToolCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{loc:Tr '移出队列'}"
                              AutomationProperties.HelpText="{Binding Label}"
                              ToolTip="{loc:Tr '移出队列'}">
                        <controls:SvgIcon Data="{StaticResource IconX}" Width="13" Height="13" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Background="{StaticResource Console}" CornerRadius="8" MinHeight="44" Padding="12,5,6,5" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding ToolInstallStatus}" Foreground="{StaticResource ConsoleAccent}" FontSize="12"
                           FontFamily="{StaticResource MonoFont}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding ToolInstallLine}" Foreground="{StaticResource ConsoleOutputInk}" FontSize="11"
                           FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="ToolInstallLiveLine">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers><DataTrigger Binding="{Binding ToolInstallLine}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="1" Background="{StaticResource ConsoleControl}" BorderThickness="0" Width="32" Height="32" MinHeight="32" Padding="5"
                      Command="{Binding ShowTerminalCommand}" AutomationProperties.Name="{loc:Tr '打开完整日志'}"
                      AutomationProperties.AutomationId="ToolInstallLogButton" ToolTip="{loc:Tr '打开完整日志'}">
                <controls:SvgIcon Data="{StaticResource IconTerminal}" Width="17" Height="17" Foreground="{StaticResource ConsoleAccent}" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="208" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <controls:SvgIcon Data="{StaticResource IconPackage}" Width="17" Height="17" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr '已安装工具'}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Grid Grid.Column="1">
            <TextBox Text="{Binding ToolFilter,UpdateSourceTrigger=PropertyChanged}" Padding="34,8,12,8"
                     ToolTip="{loc:Tr '搜索工具或版本'}" AutomationProperties.Name="{loc:Tr '搜索工具或版本'}"
                     AutomationProperties.AutomationId="ToolFilterBox">
              <TextBox.InputBindings><KeyBinding Key="Escape" Command="{Binding ClearToolFilterCommand}" /></TextBox.InputBindings>
            </TextBox>
            <controls:SvgIcon Data="{StaticResource IconSearch}" Width="14" Height="14" HorizontalAlignment="Left"
                              Margin="12,0,0,0" IsHitTestVisible="False" />
            <TextBlock Text="{loc:Tr '搜索工具'}" Foreground="{StaticResource MutedLight}" Margin="34,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ToolFilter}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>
        <Button Grid.Column="1" Command="{Binding ExportToolsCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="ExportToolsButton">
          <StackPanel Orientation="Horizontal">
            <controls:SvgIcon Data="{StaticResource IconExternalLink}" Width="13" Height="13" Margin="0,0,6,0" />
            <TextBlock Text="{loc:Tr '导出工具'}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Command="{Binding RefreshCommand}" Margin="8,0,0,0" MinWidth="76">
          <StackPanel Orientation="Horizontal">
            <controls:SvgIcon Data="{StaticResource IconRefreshCw}" Width="13" Height="13" Margin="0,0,6,0" />
            <TextBlock Text="{loc:Tr '刷新'}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Command="{Binding UpgradeToolsCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="UpgradeToolsButton">
          <StackPanel Orientation="Horizontal">
            <controls:SvgIcon Data="{StaticResource IconCircleArrowUp}" Width="14" Height="14" Margin="0,0,6,0" />
            <TextBlock Text="{loc:Tr '升级全部工具'}" />
          </StackPanel>
        </Button>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="4,0,4,6" Effect="{StaticResource CardShadow}">
        <Grid>
          <DataGrid ItemsSource="{Binding FilteredTools}" AutomationProperties.AutomationId="ToolsTable">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Tr '工具'}" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="{loc:Tr '安装版本'}" Binding="{Binding Version}" Width="1.5*" />
              <DataGridTextColumn Header="{loc:Tr '请求版本'}" Binding="{Binding Requested}" Width="1.3*" />
              <DataGridTemplateColumn Header="{loc:Tr '状态'}" Width="1.3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="9,3.5" HorizontalAlignment="Left" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Active,Converter={StaticResource ActiveToolLabel}}" Foreground="{StaticResource AccentDeep}" FontSize="11" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ToolCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
              <controls:SvgIcon Data="{StaticResource IconPackage}" Width="24" Height="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{loc:Tr '暂无工具'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
            <TextBlock Text="{loc:Tr '在上方输入 node@lts 等规格加入队列，点击「批量安装」即可。'}" Style="{StaticResource Caption}" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
