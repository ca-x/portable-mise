<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls">
  <DataTemplate x:Key="ToolsPage">
    <Grid Margin="24,24,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="320" HorizontalAlignment="Left"><TextBox Text="{Binding ToolFilter,UpdateSourceTrigger=PropertyChanged}" Padding="36,8,12,8" ToolTip="搜索工具或版本" AutomationProperties.AutomationId="ToolFilterBox"/><controls:SvgIcon Data="{StaticResource IconSearch}" Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/><TextBlock Text="搜索工具" Foreground="{StaticResource MutedLight}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ToolFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,8,0" />
        <Button Grid.Column="2" Content="升级全部工具" Command="{Binding UpgradeToolsCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="UpgradeToolsButton" />
      </Grid>
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="0,0,0,8" Margin="0,0,0,16">
        <Grid>
          <DataGrid ItemsSource="{Binding FilteredTools}" AutomationProperties.AutomationId="ToolsTable">
            <DataGrid.Columns>
              <DataGridTextColumn Header="工具" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="安装版本" Binding="{Binding Version}" Width="1.5*" />
              <DataGridTextColumn Header="请求版本" Binding="{Binding Requested}" Width="1.3*" />
              <DataGridTemplateColumn Header="状态" Width="1.3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Active,Converter={StaticResource ActiveToolLabel}}" Foreground="{StaticResource Accent}" FontSize="10" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ToolCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <controls:SvgIcon Data="{StaticResource IconPackage}" Width="30" Height="30" Foreground="{StaticResource MutedLight}" HorizontalAlignment="Center"/>
            <TextBlock Text="暂无工具" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,7" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" IsEnabled="{Binding CanOperate}">
        <StackPanel>
          <TextBlock Text="安装工具" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
              <TextBox Text="{Binding ToolSpecification,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.AutomationId="ToolSpecificationBox" />
              <TextBlock Text="例如 node@lts" Foreground="#94A6AE" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ToolSpecification}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button Grid.Column="1" Content="安装到全局环境" Command="{Binding InstallToolCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" AutomationProperties.AutomationId="InstallToolButton" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>