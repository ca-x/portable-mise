<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:PortableMise.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls">
  <DataTemplate x:Key="TerminalPage">
    <Grid Margin="28,24,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <controls:SvgIcon Data="{StaticResource IconTerminal}" Width="17" Height="17" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Tr '日志'}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Style="{StaticResource QuietButton}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <controls:SvgIcon Data="{StaticResource IconX}" Width="12" Height="12" Margin="0,0,6,0" />
            <TextBlock Text="{loc:Tr '清空记录'}" />
          </StackPanel>
        </Button>
      </Grid>
      <Border Grid.Row="1" CornerRadius="{StaticResource CardRadius}" Background="{StaticResource Console}" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Border BorderBrush="#36383E" BorderThickness="0,0,0,1" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Ellipse Width="7" Height="7" Fill="#8E8E93" Margin="0,0,7,0" />
                <TextBlock Text="mise" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#A0A0A6" />
              </StackPanel>
              <TextBlock Text="UTF-8" Foreground="#8E8E93" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Right" />
            </DockPanel>
          </Border>
          <TextBox Grid.Row="1" Text="{Binding LogText,Mode=OneWay}" controls:LogTail.IsEnabled="True" Style="{StaticResource ConsoleText}" AutomationProperties.AutomationId="OperationLogBox" />
        </Grid>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <controls:SvgIcon Data="{StaticResource IconChevronDown}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr 'mise 命令'}" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,10" Margin="0,0,9,0">
              <TextBlock Text="mise" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" />
            </Border>
            <TextBox Grid.Column="1" Text="{Binding CommandText,UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" IsEnabled="{Binding CanOperate}" AutomationProperties.AutomationId="MiseCommandBox" />
            <Button Grid.Column="2" Command="{Binding RunMiseCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,7,0" AutomationProperties.AutomationId="RunMiseButton" MinWidth="88">
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconPlay}" Width="12" Height="12" Foreground="White" Margin="0,0,7,0" />
                <TextBlock Text="{loc:Tr '运行'}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Command="{Binding OpenTerminalCommand}">
              <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource IconTerminal}" Width="13" Height="13" Margin="0,0,6,0" />
                <TextBlock Text="{loc:Tr '打开终端'}" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
