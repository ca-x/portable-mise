<Window x:Class="PortableMise.LanguageMirrorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PortableMise.Localization"
        Title="{loc:Tr '语言镜像'}" Width="640" Height="478" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/mise.ico"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="116" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr '工具或生态'}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ProfileBox" Grid.Column="1" DisplayMemberPath="Label"
                      SelectionChanged="ProfileChanged"
                      AutomationProperties.Name="{loc:Tr '工具或生态'}"
                      AutomationProperties.AutomationId="LanguageMirrorProfileBox" />
            <TextBlock Grid.Row="1" Text="{loc:Tr '镜像预设'}" VerticalAlignment="Center" Margin="0,8,8,0" />
            <ComboBox x:Name="PresetBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label"
                      SelectionChanged="PresetChanged" Margin="0,8,0,0"
                      AutomationProperties.Name="{loc:Tr '镜像预设'}"
                      AutomationProperties.AutomationId="LanguageMirrorPresetBox" />
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
              <TextBlock x:Name="DescriptionText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
              <TextBlock x:Name="CurrentText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                         TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Tr '配置预览'}" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="PreviewBox" Grid.Row="1" Style="{StaticResource ConsoleText}" IsReadOnly="True"
                     Height="Auto" VerticalAlignment="Stretch" Margin="0,8,0,0" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{loc:Tr '配置预览'}"
                     AutomationProperties.AutomationId="LanguageMirrorPreview" />
            <TextBlock Grid.Row="2" Text="{loc:Tr '配置仅写入当前便携工作区。'}"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </Grid>
        </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="{loc:Tr '关闭'}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="ApplyButton" Grid.Column="2" Content="{loc:Tr '应用镜像'}" Click="ApplyMirror"
                Style="{StaticResource PrimaryButton}" IsEnabled="False"
                AutomationProperties.AutomationId="ApplyLanguageMirrorButton" />
      </Grid>
    </Border>
  </Grid>
</Window>
