<Window x:Class="PortableMise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PortableMise.Controls"
        xmlns:loc="clr-namespace:PortableMise.Localization"
        Title="{loc:Tr 'mise工具箱'}" Icon="Assets/mise.ico"
        Width="1180" Height="780" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        controls:FocusVisual.IsTracking="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Views/Overview.xaml" />
        <ResourceDictionary Source="Views/Tools.xaml" />
        <ResourceDictionary Source="Views/Terminal.xaml" />
        <ResourceDictionary Source="Views/Updates.xaml" />
        <ResourceDictionary Source="Views/Settings.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ChromeVeil" Background="Transparent" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ChromeVeil" Property="Background" Value="{DynamicResource FieldHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ChromeVeil" Property="Opacity" Value="0.7" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ChromeVeil" Background="Transparent" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ChromeVeil" Property="Background" Value="#D93025" />
                  <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ChromeVeil" Property="Opacity" Value="0.85" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>

    <Border Grid.ColumnSpan="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" />
    <Grid Margin="20,0,12,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="Assets/mise.png" Width="30" Height="30" Stretch="Uniform" Margin="0,0,9,0"
               AutomationProperties.Name="{loc:Tr 'mise工具箱'}" />
        <TextBlock Text="{loc:Tr 'mise工具箱'}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
      </StackPanel>
    </Grid>
    <Border Grid.Column="1" BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0" Padding="24,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Command="{Binding OpenTerminalCommand}" AutomationProperties.AutomationId="HeaderOpenTerminalButton" VerticalAlignment="Center" Height="34" Padding="13,7" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <controls:SvgIcon Data="{StaticResource IconTerminal}" Width="15" Height="15" Margin="0,0,7,0" />
              <TextBlock Text="{loc:Tr '打开终端'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Height="22" Background="{StaticResource Hairline}" Margin="0,0,6,0" />
          <Button Style="{StaticResource WindowButton}" Click="OnMinimizeClick" AutomationProperties.AutomationId="WindowMinimizeButton" AutomationProperties.Name="{loc:Tr '最小化'}" ToolTip="{loc:Tr '最小化'}">
            <controls:SvgIcon Data="{StaticResource IconMinus}" Width="14" Height="14" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
          <Button Style="{StaticResource WindowButton}" Click="OnMaximizeClick" AutomationProperties.AutomationId="WindowMaximizeButton" AutomationProperties.Name="{loc:Tr '最大化'}" ToolTip="{loc:Tr '最大化'}">
            <Grid>
              <controls:SvgIcon Data="{StaticResource IconMaximize}" Width="13" Height="13" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}">
                <controls:SvgIcon.Style>
                  <Style TargetType="controls:SvgIcon">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:SvgIcon.Style>
              </controls:SvgIcon>
              <controls:SvgIcon Data="{StaticResource IconRestore}" Width="13" Height="13" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}">
                <controls:SvgIcon.Style>
                  <Style TargetType="controls:SvgIcon">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:SvgIcon.Style>
              </controls:SvgIcon>
            </Grid>
          </Button>
          <Button Style="{StaticResource CloseWindowButton}" Click="OnCloseClick" AutomationProperties.AutomationId="WindowCloseButton" AutomationProperties.Name="{loc:Tr '关闭'}" ToolTip="{loc:Tr '关闭'}">
            <controls:SvgIcon Data="{StaticResource IconX}" Width="14" Height="14" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
      <Grid Margin="12,14,12,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Command="{Binding ShowOverviewCommand}"
                       IsChecked="{Binding CurrentPage,Converter={StaticResource PageSelected},ConverterParameter=0,Mode=OneWay}"
                       AutomationProperties.AutomationId="NavOverview">
            <StackPanel Orientation="Horizontal">
              <controls:SvgIcon Data="{StaticResource IconLayoutDashboard}" Width="17" Height="17" Margin="0,0,10,0"
                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{loc:Tr '环境'}" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Command="{Binding ShowToolsCommand}"
                       IsChecked="{Binding CurrentPage,Converter={StaticResource PageSelected},ConverterParameter=1,Mode=OneWay}"
                       AutomationProperties.AutomationId="NavTools">
            <StackPanel Orientation="Horizontal">
              <controls:SvgIcon Data="{StaticResource IconPackage}" Width="17" Height="17" Margin="0,0,10,0"
                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{loc:Tr '工具'}" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Command="{Binding ShowSettingsCommand}"
                       IsChecked="{Binding CurrentPage,Converter={StaticResource PageSelected},ConverterParameter=4,Mode=OneWay}"
                       AutomationProperties.AutomationId="NavSettings">
            <StackPanel Orientation="Horizontal">
              <controls:SvgIcon Data="{StaticResource IconSettings}" Width="17" Height="17" Margin="0,0,10,0"
                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{loc:Tr '设置'}" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="8,0,8,10" />
          <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Command="{Binding ShowUpdatesCommand}"
                       IsChecked="{Binding CurrentPage,Converter={StaticResource PageSelected},ConverterParameter=3,Mode=OneWay}"
                       AutomationProperties.AutomationId="NavUpdates">
            <StackPanel Orientation="Horizontal">
              <controls:SvgIcon Data="{StaticResource IconRefreshCw}" Width="17" Height="17" Margin="0,0,10,0"
                                Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{loc:Tr '版本更新'}" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <TextBlock Text="{Binding ApplicationVersion,StringFormat=v{0}}" Foreground="{StaticResource MutedLight}"
                     FontSize="11" Margin="14,6,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding}" RenderTransformOrigin="0.5,0">
      <ContentControl.RenderTransform>
        <TranslateTransform />
      </ContentControl.RenderTransform>
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Setter Property="ContentTemplate" Value="{StaticResource OverviewPage}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentPage}" Value="1"><Setter Property="ContentTemplate" Value="{StaticResource ToolsPage}" /></DataTrigger>
            <DataTrigger Binding="{Binding CurrentPage}" Value="2"><Setter Property="ContentTemplate" Value="{StaticResource TerminalPage}" /></DataTrigger>
            <DataTrigger Binding="{Binding CurrentPage}" Value="3"><Setter Property="ContentTemplate" Value="{StaticResource UpdatesPage}" /></DataTrigger>
            <DataTrigger Binding="{Binding CurrentPage}" Value="4"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPage}" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>

    <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="24,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{loc:Tr '取消'}" Command="{Binding CancelCommand}"
                Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"
                Style="{StaticResource QuietButton}" Height="26" MinHeight="26" Padding="8,2" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ProgressBar Grid.Column="1" Height="2" IsIndeterminate="True" VerticalAlignment="Bottom" Foreground="{StaticResource Accent}" BorderThickness="0"
                 Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" />
  </Grid>
</Window>
