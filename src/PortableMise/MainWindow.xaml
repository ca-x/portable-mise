<Window x:Class="PortableMise.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PortableMise.Controls" Title="portable mise" Icon="Assets/mise.ico" Width="1180" Height="780" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource BodyFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Views/Overview.xaml"/><ResourceDictionary Source="Views/Tools.xaml"/><ResourceDictionary Source="Views/Terminal.xaml"/><ResourceDictionary Source="Views/Updates.xaml"/><ResourceDictionary Source="Views/Settings.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Background="{DynamicResource Canvas}"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="12,24,12,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="12,0,0,32"><Image Source="Assets/mise.png" Width="32" Height="36" Margin="0,0,10,0"/><TextBlock Text="portable mise" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/></StackPanel>
      <StackPanel Grid.Row="1">
        <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Command="{Binding ShowOverviewCommand}" IsChecked="{Binding CurrentPage,Converter={StaticResource PageSelected},ConverterParameter=0,Mode=OneWay}" AutomationProperties.AutomationId="NavOverview"><StackPanel Orientation="Horizontal"><controls:SvgIcon Data="{StaticResource IconLayoutDashboard}" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="环境"/></StackPanel></RadioButton>
        <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Command="{Binding ShowToolsCommand}" IsChecked="{Binding CurrentPage,Converter={StaticResource PageSelected},ConverterParameter=1,Mode=OneWay}" AutomationProperties.AutomationId="NavTools"><StackPanel Orientation="Horizontal"><controls:SvgIcon Data="{StaticResource IconPackage}" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="工具"/></StackPanel></RadioButton>
        <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Command="{Binding ShowSettingsCommand}" IsChecked="{Binding CurrentPage,Converter={StaticResource PageSelected},ConverterParameter=4,Mode=OneWay}" AutomationProperties.AutomationId="NavSettings"><StackPanel Orientation="Horizontal"><controls:SvgIcon Data="{StaticResource IconSettings}" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="设置"/></StackPanel></RadioButton>
      </StackPanel>
      <StackPanel Grid.Row="3"><Button Command="{Binding ShowTerminalCommand}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="NavTerminal"><StackPanel Orientation="Horizontal"><controls:SvgIcon Data="{StaticResource IconTerminal}" Width="16" Height="16" Margin="0,0,10,0"/><TextBlock Text="日志与命令"/></StackPanel></Button><Button Command="{Binding ShowUpdatesCommand}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="NavUpdates"><StackPanel Orientation="Horizontal"><controls:SvgIcon Data="{StaticResource IconRefreshCw}" Width="16" Height="16" Margin="0,0,10,0"/><TextBlock Text="版本更新"/></StackPanel></Button><TextBlock Text="{Binding ApplicationVersion,StringFormat=v{0}}" Foreground="{StaticResource MutedLight}" FontSize="11" Margin="16,16,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition/><RowDefinition Height="40"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PageTitle}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Command="{Binding OpenTerminalCommand}" AutomationProperties.AutomationId="HeaderOpenTerminalButton"><StackPanel Orientation="Horizontal"><controls:SvgIcon Data="{StaticResource IconTerminal}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="打开终端"/></StackPanel></Button></Grid></Border>
      <ContentControl Grid.Row="1" Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource OverviewPage}"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="1"><Setter Property="ContentTemplate" Value="{StaticResource ToolsPage}"/></DataTrigger><DataTrigger Binding="{Binding CurrentPage}" Value="2"><Setter Property="ContentTemplate" Value="{StaticResource TerminalPage}"/></DataTrigger><DataTrigger Binding="{Binding CurrentPage}" Value="3"><Setter Property="ContentTemplate" Value="{StaticResource UpdatesPage}"/></DataTrigger><DataTrigger Binding="{Binding CurrentPage}" Value="4"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPage}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QuietButton}" Height="28" MinHeight="28" Padding="8,2"/></Grid></Border>
      <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True" VerticalAlignment="Bottom" Foreground="{StaticResource Accent}" BorderThickness="0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/>
    </Grid>
  </Grid>
</Window>